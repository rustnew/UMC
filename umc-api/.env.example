# UMC API — Environment Configuration (example)
# Copy to .env and fill in real values:
#   cp umc-api/.env.example umc-api/.env

# PostgreSQL connection string
DATABASE_URL=postgres://umc:umc_password@localhost:5432/umc_db

# JWT signing secret — MUST be changed in production (min 32 chars)
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars

# Server binding
UMC_HOST=0.0.0.0
UMC_PORT=8080

# Storage directories
UPLOAD_DIR=/tmp/umc/uploads
OUTPUT_DIR=/tmp/umc/outputs

# Limits
MAX_UPLOAD_BYTES=107374182400
MAX_CONCURRENT_CONVERSIONS=4

# CORS
CORS_ORIGIN=http://localhost:5173

# Logging
RUST_LOG=info,umc_api=debug